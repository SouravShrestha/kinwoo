{
  "name": "@kinwoo/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "build:dev:android": "GOOGLE_SERVICES_JSON=$PWD/google-services.json eas build --platform android --profile development --local",
    "build:local:android": "GOOGLE_SERVICES_JSON=$PWD/google-services.json eas build --platform android --local --profile local --output ./builds/app-local-$(date +%s).apk"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "0.4.2",
    "@expo-google-fonts/poppins": "0.4.1",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@kinwoo/client": "*",
    "@kinwoo/core": "*",
    "@kinwoo/icons": "*",
    "@kinwoo/tokens": "*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "2.117.3",
    "@tanstack/query-async-storage-persister": "5.104.1",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-query-persist-client": "5.104.1",
    "expo": "~57.0.25",
    "expo-asset": "~57.0.19",
    "expo-build-properties": "~57.0.22",
    "expo-camera": "57.0.6",
    "expo-clipboard": "57.0.2",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-image": "57.0.5",
    "expo-linking": "~57.0.11",
    "expo-network": "~57.0.3",
    "expo-notifications": "~57.0.24",
    "expo-router": "~57.0.23",
    "expo-secure-store": "57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "nativewind": "^4.1.23",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-css-interop": "0.2.7",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-share": "12.3.1",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.4",
    "tailwindcss": "^3.4.17",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.2.0",
    "typescript": "~6.0.3",
    "vitest": "^3.2.4"
  },
  "expo": {
    "install": {
      "exclude": [
        "tailwindcss"
      ]
    }
  }
}
