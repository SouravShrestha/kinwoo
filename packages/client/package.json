{
  "name": "@kinwoo/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "The client/server seam both apps share. Platform differences are injected, not branched on.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./activity": "./src/activity/index.ts",
    "./api": "./src/api/index.ts",
    "./auth": "./src/auth/index.ts",
    "./expenses": "./src/expenses/index.ts",
    "./profile": "./src/profile/index.ts",
    "./houses": "./src/houses/index.ts",
    "./grocery": "./src/grocery/index.ts",
    "./sheets": "./src/sheets/index.ts",
    "./toast": "./src/toast/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@kinwoo/core": "*"
  },
  "peerDependencies": {
    "@supabase/supabase-js": ">=2",
    "@tanstack/query-async-storage-persister": ">=5",
    "@tanstack/react-query": ">=5",
    "@tanstack/react-query-persist-client": ">=5",
    "react": ">=19"
  },
  "devDependencies": {
    "@supabase/supabase-js": "2.117.3",
    "@tanstack/query-async-storage-persister": "5.104.1",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-query-persist-client": "5.104.1",
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.0",
    "vitest": "^3.2.4"
  }
}
